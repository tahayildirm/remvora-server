# Inject actual secrets through deployment configuration; never commit a populated .env.
Database__Provider=PostgreSQL
# Database__ServerVersion: optional, e.g. 8.4.0 for MySQL or 11.4.0 for MariaDB.
ConnectionStrings__Database=
Security__AllowedOrigin=https://remvora.example
Security__KeyRingPath=
Security__KeyRingCertificate=
Security__KeyRingPassword=
AllowedHosts=remvora.example
WebRtc__StunServers__0=
Security__Policy__EnrollmentMinutes=10
Security__Policy__ChallengeSeconds=60
Security__Policy__SessionTicketSeconds=60
Security__Policy__UserSessionMinutes=720
Security__Policy__RemoteSessionMinutes=60
